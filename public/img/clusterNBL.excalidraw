    {
      "id": "TTn3EZc6VomFcCSmky2eX",
      "type": "text",
      "x": 1116.3020629882812,
      "y": 151.10546875,
      "width": 476.3685302734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 1308697062,
      "version": 48,
      "versionNonce": 1789639738,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792337365675,
      "created": 1792337358465,
      "link": null,
      "locked": false,
      "text": "El cliente realiza una solicitud. Por ejemplo, abre\nuna página web utilizando la IP virtual 10.0.0.3.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El cliente realiza una solicitud. Por ejemplo, abre una página web utilizando la IP virtual 10.0.0.3.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qaAC0thgyUoB9_t2uet_h",
      "type": "text",
      "x": 1092.5619506835938,
      "y": 425.4296875,
      "width": 578.8721923828125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 2130802106,
      "version": 51,
      "versionNonce": 876498150,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792337405974,
      "created": 1792337391824,
      "link": null,
      "locked": false,
      "text": "El clúster recibe el tráfico. Los nodos NLB utilizan un\nmecanismo distribuido para determinar qué servidor\natenderá cada conexión.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El clúster recibe el tráfico. Los nodos NLB utilizan un mecanismo distribuido para determinar qué servidor atenderá cada conexión.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "3TThiYuVITqgwSJOa6HUu",
      "type": "text",
      "x": 1132.3323669433594,
      "y": 826.62109375,
      "width": 542.3977661132812,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 1343023718,
      "version": 48,
      "versionNonce": 317930234,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792337400825,
      "created": 1792337397072,
      "link": null,
      "locked": false,
      "text": "Un servidor procesa la solicitud. El servidor elegido\nresponde al cliente.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un servidor procesa la solicitud. El servidor elegido responde al cliente.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "DBvMddw9kQVJx1C8aIxnV",
      "type": "text",
      "x": 1123.0704956054688,
      "y": 531.8799144338701,
      "width": 429.00744628906233,
      "height": 58.22906412425095,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 1463846394,
      "version": 116,
      "versionNonce": 560722106,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792337424142,
      "created": 1792337411456,
      "link": null,
      "locked": false,
      "text": "NLB supervisa la disponibilidad de los nodos. Si un\nservidor deja de participar, los nodos restantes ajustan\nla distribución del tráfico.",
      "fontSize": 15.527750433133585,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NLB supervisa la disponibilidad de los nodos. Si un servidor deja de participar, los nodos restantes ajustan la distribución del tráfico.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
