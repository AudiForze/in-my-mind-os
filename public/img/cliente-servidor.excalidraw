    {
      "id": "PUXmJXrRAqyHPxeCv0ZTH",
      "type": "text",
      "x": 1163.28515625,
      "y": 302.265625,
      "width": 313.48828124999994,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 1647542061,
      "version": 96,
      "versionNonce": 1681649827,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790785902147,
      "created": 1790785857908,
      "link": null,
      "locked": false,
      "text": "La Place de arduino solo\npermite la conexión de un\ndispositivo a la vez, por lo que\nno podíamos utilizar varios\ndispositivos de forma\nsimultánea ni utilizar el cable\nUSB-serial y aplicaciones\nPySerial simultáneamente. Esto\nnos deja un problema grande si\ncreamos una aplicación de\nescritorio y un sitio web para\nque cualquier persona pueda\ninteractuar con el proyecto.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La Place de arduino solo permite la conexión de un dispositivo a la vez, por lo que no podíamos utilizar varios dispositivos de forma simultánea ni utilizar el cable USB-serial y aplicaciones PySerial simultáneamente. Esto nos deja un problema grande si creamos una aplicación de escritorio y un sitio web para que cualquier persona pueda interactuar con el proyecto.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
