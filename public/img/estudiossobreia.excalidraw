      "updated": 1755634003343,
      "link": null,
      "locked": false,
      "text": "Cuantas veces se\nhace esto?",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "X83i0X0_QnWDV_DY0mUeK",
      "originalText": "Cuantas veces se hace esto?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "M_QtjW2iQAteY9A61dGK0",
      "type": "text",
      "x": 2449.477830110282,
      "y": 1574.6091708994657,
      "width": 130.23698633352296,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAg",
      "roundness": null,
      "seed": 541048316,
      "version": 254,
      "versionNonce": 22470012,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755635125097,
      "link": null,
      "locked": false,
      "text": "Para esto se\nutiliza las\nepocas que son\nlas cantidades\nde veces que\nqueremos y\nnecesitamos\nhacer este\nproceso",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para esto se utiliza las epocas que son las cantidades de veces que queremos y necesitamos hacer este proceso",
