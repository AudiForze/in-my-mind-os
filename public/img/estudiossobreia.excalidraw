      "seed": 368337870,
      "version": 59,
      "versionNonce": 1580663502,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776551896157,
      "link": null,
      "locked": false,
      "text": "Un transformador es un modelo de aprendizaje profundo que usa el mecanismo de\nautoatención, en el que se le da un peso diferente a cada parte de la entrada.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un transformador es un modelo de aprendizaje profundo que usa el mecanismo de autoatención, en el que se le da un peso diferente a cada parte de la entrada.",
      "autoResize": false,
      "lineHeight": 1.25
    },
