    {
      "id": "HFBaT48OFZWSGSx0gB_rO",
      "type": "text",
      "x": 5697.181848946291,
      "y": 1093.952998904221,
      "width": 347.839111328125,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAl",
      "roundness": null,
      "seed": 1310998411,
      "version": 375,
      "versionNonce": 679612188,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756606479875,
      "link": null,
      "locked": false,
      "text": "Este es un modelo que trata de fijarse\ne imitar al mejor razonador de la\nhistoria (el cerebo humano) donde se\nbusca imitar ciertas actividades\ncerebales para poder imitar el\nrazonamiento.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Este es un modelo que trata de fijarse e imitar al mejor razonador de la historia (el cerebo humano) donde se busca imitar ciertas actividades cerebales para poder imitar el razonamiento.",
      "autoResize": false,
      "lineHeight": 1.25
    },
