      "boundElements": [
        {
          "id": "X83i0X0_QnWDV_DY0mUeK",
          "type": "arrow"
        }
      ],
      "updated": 1755635125097,
      "link": null,
      "locked": false,
      "text": "La funcion de\nbackpropagation lo que hace\nes una reprogramacion de\nlos pesos para poder\nencontrar la probabilidad\nmas exacta y verdadera\ndentro de la red neuronal",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La funcion de backpropagation lo que hace es una reprogramacion de los pesos para poder encontrar la probabilidad mas exacta y verdadera dentro de la red neuronal",
      "autoResize": false,
      "lineHeight": 1.25
    },
