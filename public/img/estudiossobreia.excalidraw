    },
    {
      "id": "0fCplTjdbyQBUIH-OsnEt",
      "type": "text",
      "x": 9861.933274668561,
      "y": 1258.0036645700418,
      "width": 685.2072599186012,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTg",
      "roundness": null,
      "seed": 827868011,
      "version": 850,
      "versionNonce": 1658514309,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776567505204,
      "link": null,
      "locked": false,
      "text": "En lugar de buscar desde el inicio hasta la meta en una sola dirección, el\nalgoritmo realiza dos búsquedas:\n\n- Una búsqueda hacia adelante desde el estado inicial.\n- Una búsqueda hacia atrás desde el estado objetivo.\n\nCuando ambas búsquedas se intersectan, se reconstruye el camino completo\nuniendo las dos mitades.\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En lugar de buscar desde el inicio hasta la meta en una sola dirección, el algoritmo realiza dos búsquedas:\n\n- Una búsqueda hacia adelante desde el estado inicial.\n- Una búsqueda hacia atrás desde el estado objetivo.\n\nCuando ambas búsquedas se intersectan, se reconstruye el camino completo uniendo las dos mitades.\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
