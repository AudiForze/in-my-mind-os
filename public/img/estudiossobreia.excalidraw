    {
      "id": "lQkNfPPV5mORpO82uLxma",
      "type": "text",
      "x": 3512.3277843785186,
      "y": 2568.3388512193983,
      "width": 349.81514765895537,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEQ",
      "roundness": null,
      "seed": 1035884814,
      "version": 982,
      "versionNonce": 1236804434,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776551694273,
      "link": null,
      "locked": false,
      "text": "Es un grafo dirigido que no tiene ciclos;\nesto significa que para cada vértice v, no\nhay un camino directo que empiece y termine\nen v.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Es un grafo dirigido que no tiene ciclos; esto significa que para cada vértice v, no hay un camino directo que empiece y termine en v.",
      "autoResize": false,
      "lineHeight": 1.25
    },
