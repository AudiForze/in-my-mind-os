    {
      "id": "qvDVuofU8D0AEFjPweMVG",
      "type": "text",
      "x": 9964.910889842196,
      "y": 1690.8568597632486,
      "width": 566.264753960404,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
