    {
      "id": "fzHyVGMdAZp0qcpOSRti5",
      "type": "text",
      "x": 1630.0277716174078,
      "y": 511.35916972746486,
      "width": 364.7356872558594,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2i",
