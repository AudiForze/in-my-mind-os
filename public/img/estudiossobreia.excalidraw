    {
      "id": "2Pyv5qgU6Na9Rr9me3oMQ",
      "type": "text",
      "x": 3884.4018686630898,
      "y": 3615.077410818843,
      "width": 394.05616928052007,
      "height": 80,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH3",
      "roundness": null,
      "seed": 1203686546,
      "version": 284,
      "versionNonce": 1570655314,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776554193569,
      "link": null,
      "locked": false,
      "text": "Esta es una herramienta que hace un analisis\ncuantitativo del mercado basado en las\ncadenas de markov para determinar cual seria\nel proximo de estado del mercado.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Esta es una herramienta que hace un analisis cuantitativo del mercado basado en las cadenas de markov para determinar cual seria el proximo de estado del mercado.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "nQJ3zI3kCccTz2BES1Ijs",
      "type": "text",
      "x": 3865.3830269343234,
      "y": 3810.0205385386867,
      "width": 429.3390261101558,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH5",
      "roundness": null,
      "seed": 1527534674,
      "version": 188,
      "versionNonce": 2141856014,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776554165399,
      "link": null,
      "locked": false,
      "text": "Matriz con probabilidades que luego se\nmultiplicada cada una por 100 para poder obtener\nun porcentaje sobre 100.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Matriz con probabilidades que luego se multiplicada cada una por 100 para poder obtener un porcentaje sobre 100.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Lck_L5xam-rqYq9lTnP2o",
      "type": "text",
      "x": 3798.817080883645,
      "y": 3889.661938277891,
      "width": 538.152580384513,
      "height": 51.67925674366552,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH6",
      "roundness": null,
      "seed": 788968018,
      "version": 57,
      "versionNonce": 149698002,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776554187909,
      "link": null,
      "locked": false,
      "text": "        prob_df = pd.DataFrame(model.transmat_ * 100, \n                               columns=[mapping[i] for i in range(3)], \n                               index=[mapping[i] for i in range(3)])",
      "fontSize": 13.781135131644145,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "        prob_df = pd.DataFrame(model.transmat_ * 100, \n                               columns=[mapping[i] for i in range(3)], \n                               index=[mapping[i] for i in range(3)])",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "COpmpzKuFJcrVGTIFh5Au",
      "type": "text",
      "x": 4591.771890686417,
      "y": 3529.385617704041,
      "width": 592.8281860351562,
      "height": 681.4754934555554,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIH",
      "roundness": null,
      "seed": 1224509202,
      "version": 211,
      "versionNonce": 2144333906,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "DeL4dNySMwSMBQEEz5-iR",
          "type": "arrow"
        },
        {
          "id": "ni0tVFicC0eHqk_cwivG1",
          "type": "arrow"
        }
      ],
      "updated": 1776554411089,
      "link": null,
      "locked": false,
      "text": "# 1. Función para obtener datos\n@st.cache_data(ttl=900) # Actualizar cada 15 min\ndef load_data():\n    # Descargamos los últimos 10 días para tener suficiente histórico de 15m\n    df = yf.download(\"NQ=F\", period=\"10d\", interval=\"15m\")\n    df.columns = [col[0] if isinstance(col, tuple) else col for col in df.columns]\n    \n    # Feature Engineering\n    df['Returns'] = np.log(df['Close'] / df['Close'].shift(1))\n    df['Range'] = (df['High'] - df['Low']) / df['Close']\n    df['Vol_Change'] = df['Volume'].pct_change()\n    df.dropna(inplace=True)\n    return df\n\n# 2. Motor de Inteligencia (HMM)\ndef run_hmm(df):\n    features = df[['Returns', 'Range', 'Vol_Change']]\n    scaler = StandardScaler()\n    features_scaled = scaler.fit_transform(features)\n    \n    # Definimos 3 estados: 0=Lateral, 1=Bajista/Volátil, 2=Alcista\n    model = GaussianHMM(n_components=3, covariance_type=\"full\", n_iter=1000, random_state=42)\n    model.fit(features_scaled)\n    \n    states = model.predict(features_scaled)\n    return model, states, scaler\n\n# Ejecución del pipeline\ntry:\n    data = load_data()\n    model, states, scaler = run_hmm(data)\n    data['State'] = states\n\n    # Identificar qué estado es cual (basado en medias de retornos)\n    state_means = []\n    for i in range(3):\n        state_means.append(data[data['State'] == i]['Returns'].mean())\n    \n    # Mapeo dinámico de estados\n    idx_sorted = np.argsort(state_means)\n    mapping = {idx_sorted[0]: \"BAJISTA / VOLÁTIL 🔴\", \n               idx_sorted[1]: \"LATERAL / CONSOLIDACIÓN 🟡\", \n               idx_sorted[2]: \"ALCISTA / TENDENCIA 🟢\"}\n    \n    current_state_idx = states[-1]\n    current_label = mapping[current_state_idx]\n",
      "fontSize": 11.599582867328602,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 1. Función para obtener datos\n@st.cache_data(ttl=900) # Actualizar cada 15 min\ndef load_data():\n    # Descargamos los últimos 10 días para tener suficiente histórico de 15m\n    df = yf.download(\"NQ=F\", period=\"10d\", interval=\"15m\")\n    df.columns = [col[0] if isinstance(col, tuple) else col for col in df.columns]\n    \n    # Feature Engineering\n    df['Returns'] = np.log(df['Close'] / df['Close'].shift(1))\n    df['Range'] = (df['High'] - df['Low']) / df['Close']\n    df['Vol_Change'] = df['Volume'].pct_change()\n    df.dropna(inplace=True)\n    return df\n\n# 2. Motor de Inteligencia (HMM)\ndef run_hmm(df):\n    features = df[['Returns', 'Range', 'Vol_Change']]\n    scaler = StandardScaler()\n    features_scaled = scaler.fit_transform(features)\n    \n    # Definimos 3 estados: 0=Lateral, 1=Bajista/Volátil, 2=Alcista\n    model = GaussianHMM(n_components=3, covariance_type=\"full\", n_iter=1000, random_state=42)\n    model.fit(features_scaled)\n    \n    states = model.predict(features_scaled)\n    return model, states, scaler\n\n# Ejecución del pipeline\ntry:\n    data = load_data()\n    model, states, scaler = run_hmm(data)\n    data['State'] = states\n\n    # Identificar qué estado es cual (basado en medias de retornos)\n    state_means = []\n    for i in range(3):\n        state_means.append(data[data['State'] == i]['Returns'].mean())\n    \n    # Mapeo dinámico de estados\n    idx_sorted = np.argsort(state_means)\n    mapping = {idx_sorted[0]: \"BAJISTA / VOLÁTIL 🔴\", \n               idx_sorted[1]: \"LATERAL / CONSOLIDACIÓN 🟡\", \n               idx_sorted[2]: \"ALCISTA / TENDENCIA 🟢\"}\n    \n    current_state_idx = states[-1]\n    current_label = mapping[current_state_idx]\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
