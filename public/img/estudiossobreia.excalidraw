      "link": null,
      "locked": false,
      "text": "una stack (o pila) es una estructura de\ndatos lineal que sigue un orden\nespecífico para gestionar los\nelementos: el principio LIFO (Last-In,\nFirst-Out).",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "una stack (o pila) es una estructura de datos lineal que sigue un orden específico para gestionar los elementos: el principio LIFO (Last-In, First-Out).",
      "autoResize": false,
      "lineHeight": 1.25
    },
