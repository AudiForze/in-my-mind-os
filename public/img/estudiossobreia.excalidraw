      "seed": 1946727834,
      "version": 229,
      "versionNonce": 1082770310,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755482565481,
      "link": null,
      "locked": false,
      "text": "Un perceptrón es una red neuronal sencilla con \nuna sola capa de neuronas, que se suele \nutilizar para tareas de clasificación lineal. \nConsta de una capa de entrada y una capa \nde salida sin capas ocultas.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un perceptrón es una red neuronal sencilla con \nuna sola capa de neuronas, que se suele \nutilizar para tareas de clasificación lineal. \nConsta de una capa de entrada y una capa \nde salida sin capas ocultas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
