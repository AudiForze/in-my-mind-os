    {
      "id": "7pwOuYzB-HpbgOngRwfkZ",
      "type": "text",
      "x": 7659.375191666993,
      "y": 3049.4428293102083,
      "width": 345.20725991859933,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
