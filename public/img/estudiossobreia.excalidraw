    {
      "id": "AptbluT1dfv1SzFupYQ9w",
      "type": "text",
      "x": 6718.849038090913,
      "y": 1086.9646347976043,
      "width": 184.79974365234375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
