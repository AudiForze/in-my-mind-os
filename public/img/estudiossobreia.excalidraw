    {
      "id": "xPcJ2wh7Leww5pgs0_-YR",
      "type": "text",
      "x": 2713.973335477752,
      "y": 3351.7232215223416,
      "width": 791.9989013671875,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
