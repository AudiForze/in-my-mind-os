    {
      "id": "ahTHfKyg6kccBmvgWxjAg",
      "type": "text",
      "x": 3506.7987571428243,
      "y": 2389.6895460165083,
      "width": 369.3993135503224,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bET",
      "roundness": null,
      "seed": 915475406,
      "version": 1008,
      "versionNonce": 501107858,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776551694273,
      "link": null,
      "locked": false,
      "text": "Las cadenas de Markov son un modelo\nmatemático que se utiliza para describir\nsistemas que cambian de estado a lo largo del\ntiempo, donde el estado futuro depende\núnicamente del estado actual y no del historial\nprevio. A esta propiedad se le llama propiedad\nde Markov o falta de memoria.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Las cadenas de Markov son un modelo matemático que se utiliza para describir sistemas que cambian de estado a lo largo del tiempo, donde el estado futuro depende únicamente del estado actual y no del historial previo. A esta propiedad se le llama propiedad de Markov o falta de memoria.",
      "autoResize": false,
      "lineHeight": 1.25
    },
