      "text": "Cadena de Markov (de\ntiempo discreto) en\nun espacio de estados\nnumerable o finito.",
      "fontSize": 13.493460881770993,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cadena de Markov (de tiempo discreto) en un espacio de estados numerable o finito.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ybBC3_-uAjbuckv_INs-S",
      "type": "text",
      "x": 3078.1234454456435,
      "y": 2684.571967654305,
      "width": 160.48427313743025,
      "height": 67.46730440885497,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
