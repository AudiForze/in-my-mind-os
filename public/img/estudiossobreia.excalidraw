    },
    {
      "id": "kP0XzIS6rWbA84dzRQ2jh",
      "type": "arrow",
      "x": 5956.37838313714,
      "y": 2264.131761186733,
      "width": 1.5885554607302765,
      "height": 39.7144925133216,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
