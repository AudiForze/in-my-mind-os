    {
      "id": "qqX4HZOahy6P68xYQdiW5",
      "type": "text",
      "x": 8068.872410747581,
      "y": 3260.175239592828,
      "width": 193.5997314453125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
